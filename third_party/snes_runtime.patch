+int kss_capture_lines;
+void kss_mods_line(uint16_t* cgram, int line);
+static void kss_capture_line(Ppu* ppu, int y) {
+  kss_mods_line(ppu->cgram, y);
+  if (!kss_capture_lines || y < 0 || y >= 256) return;
+  KssLineRegs* L = &kss_line_regs[y];
+  memcpy(kss_line_cgram[y], ppu->cgram, sizeof ppu->cgram);
+  L->mode = PPU_mode(ppu); L->enabled = ppu->screenEnabled[0] | ppu->screenEnabled[1] << 8;
+  for (int l = 0; l < 4; l++) {
+    L->tilemap[l] = PPU_bgTilemapAdr(ppu, l); L->tileadr[l] = PPU_bgTileAdr(ppu, l);
+    L->xsc[l] = ppu->bgXsc[l] & 3; L->big[l] = PPU_bigTiles(ppu, l) ? 1 : 0;
+    L->hs[l] = ppu->hScroll[l]; L->vs[l] = ppu->vScroll[l];
+  }
+}

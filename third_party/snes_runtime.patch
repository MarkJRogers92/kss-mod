+/* KSS-MOD: native-only expansion ROM. Banks 70-7D are unmapped for both the
+ * S-CPU and the SA-1 on this board; when an expansion image is loaded they read
+ * it (full 64 KiB banks, read-only), otherwise they stay open bus. Static data
+ * like the ROM, so it is not part of save states. */
+#define KSS_XROM_BANK0 0x70
+#define KSS_XROM_BANKS 14
+static uint8_t *g_kss_xrom;
+static uint32_t g_kss_xrom_size;
+
+static bool kss_xrom_offset(uint8_t bank, uint16_t address, uint32_t *offset) {
+  if (!g_kss_xrom || bank < KSS_XROM_BANK0 ||
+      bank >= KSS_XROM_BANK0 + KSS_XROM_BANKS) return false;
+  *offset = ((uint32_t)(bank - KSS_XROM_BANK0) << 16) | address;
+  return *offset < g_kss_xrom_size;
 }
 
